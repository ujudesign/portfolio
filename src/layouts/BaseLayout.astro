---
// Self-hosted Geist fonts (variable — all weights in one small file each).
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "lenis/dist/lenis.css";
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Suthan — Product Designer",
  description = "Selected work by Suthan.",
} = Astro.props;

const namespace = Astro.url.pathname.startsWith("/work/") ? "case-study" : "home";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      document.documentElement.classList.add("js");
      // Always start at the top so the intro loader is tied to the hero.
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    </script>
  </head>
  <body data-barba="wrapper" class="text-neutral-900 antialiased">
    <div
      data-curtain
      class="curtain"
      aria-hidden="true"
    >
      <div data-curtain-panel class="curtain-panel curtain-panel--1"></div>
      <div data-curtain-panel class="curtain-panel curtain-panel--2"></div>
      <div data-curtain-panel class="curtain-panel curtain-panel--3"></div>
    </div>
    <Header />
    {/* Progressive-blur header-fade effect parked (not deleted) — see global.css .progressive-blur — it was built for the old full-width header and doesn't fit the compact nav. */}
    <div data-barba="container" data-barba-namespace={namespace}>
      <slot />
      {/* Footer parked in src/components/Footer.astro while the site is rebuilt. */}
    </div>

    <script>
      import { initAnimations } from "../scripts/animations.js";
      initAnimations();
    </script>
  </body>
</html>
