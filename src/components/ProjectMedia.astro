---
import type { ImageMetadata } from "astro";
import SmartImage from "./SmartImage.astro";

interface Props {
  src: ImageMetadata | string;
  alt?: string;
}

const { src, alt = "" } = Astro.props;
const source = typeof src === "string" ? src : "";
const isVideo = /\.(mp4|webm)(?:[?#].*)?$/i.test(source);

// Videos live beside CMS-uploaded images in src/assets/uploads. Vite turns
// local video files into public build URLs while remote URLs pass through.
const localVideos = import.meta.glob<string>("../assets/uploads/*.{mp4,webm,MP4,WEBM}", {
  eager: true,
  query: "?url",
  import: "default",
});

const filename = source.split(/[?#]/, 1)[0]?.split("/").pop();
const localVideo = filename ? localVideos[`../assets/uploads/${filename}`] : undefined;
const videoSrc = localVideo ?? source;
---

{
  isVideo ? (
    <video
      src={videoSrc}
      muted
      loop
      playsinline
      preload="metadata"
      disablepictureinpicture
      data-gallery-video
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : "true"}
    />
  ) : (
    <SmartImage
      src={src}
      alt={alt}
      widths={[800, 1400, 2200, 3200, 4000]}
      sizes="100vw"
      quality={92}
    />
  )
}
