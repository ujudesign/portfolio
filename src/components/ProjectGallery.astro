---
import { getCollection } from "astro:content";
import ProjectMedia from "./ProjectMedia.astro";

// Match the explicit order shown in the CMS rather than relying on filenames.
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.displayOrder - b.data.displayOrder || a.data.title.localeCompare(b.data.title)
);

// Rendered 3x so the strip can loop seamlessly — see initProjectGallery in
// src/scripts/animations.js for the scroll/seam-correction logic this drives.
const copies = [0, 1, 2];
---

{
  projects.length > 0 && (
    <section data-gallery class="relative flex min-h-0 flex-1 flex-col">
      <div class="gallery-bar">
        <p data-gallery-reveal class="gallery-label">Work '24 - '26</p>

        <nav data-gallery-nav aria-label="Projects" class="gallery-nav">
          {projects.map((project) => (
            <button
              type="button"
              data-gallery-link
              data-project-id={project.id}
              class="gallery-nav__item"
            >
              {project.data.title}
            </button>
          ))}
        </nav>
      </div>

      <div data-gallery-viewport class="gallery-viewport">
        <div data-gallery-track class="gallery-track">
          {copies.map((copyIndex) => (
            <div data-gallery-copy class="gallery-copy" aria-hidden={copyIndex !== 0 ? "true" : undefined}>
              {projects.map((project) => (
                <div data-project-group data-project-id={project.id} class="project-group">
                  {project.data.images.map((media) => (
                    <figure class="gallery-image" data-gallery-entrance={copyIndex === 2 ? true : undefined}>
                      <ProjectMedia src={media} />
                    </figure>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>

      <div data-gallery-cursor class="gallery-drag-cursor" aria-hidden="true">
        <span data-gallery-cursor-face class="gallery-drag-cursor__face">
          <span class="gallery-drag-cursor__mask"><span data-gallery-cursor-line>Drag /<br />Scroll</span></span>
        </span>
      </div>
    </section>
  )
}
