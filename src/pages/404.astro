---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — Suthan"
  description="The page you’re looking for could not be found."
>
  <main class="flex min-h-[100dvh] flex-col overflow-hidden px-[10px] pb-[10px]">
    <section class="flex min-h-0 flex-1 flex-col justify-between">
      <div
        class="ml-auto w-full pt-[clamp(5.5rem,7vh,6.5rem)] lg:w-[540px] lg:pt-[10px]"
      >
        <p
          class="mb-[18px] text-[10px] font-medium uppercase tracking-[0.06em] text-[#9d9d9d]"
        >
          Error / 404
        </p>
        <h1
          data-hero
          data-split-heading
          class="max-w-[520px] text-[24px] font-medium leading-[30px] tracking-[-0.5px] text-black"
        >
          This page doesn’t exist, or it may have moved somewhere else.
        </h1>
        <p
          data-hero
          data-split-paragraph
          class="mt-[6px] max-w-[420px] text-[14px] leading-normal tracking-[-0.1px] text-black"
        >
          Let’s get you back to the work.
        </p>
        <a
          href="/"
          class="group mt-[24px] inline-flex items-center gap-[8px] text-[10px] font-medium uppercase tracking-[0.06em] text-black"
        >
          Back home
          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover:translate-x-[3px]"
          >
            →
          </span>
        </a>
      </div>

      <p
        aria-hidden="true"
        class="font-medium text-black"
        style="margin-bottom: -0.11em; font-size: clamp(8rem, 27vw, 29rem); line-height: 0.75; letter-spacing: -0.075em;"
      >
        404
      </p>
    </section>
  </main>
</BaseLayout>
