---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
// FeaturedWork, Philosophy, and the old loader/portrait/hero-bg markup are
// parked (not deleted) — see src/components/FeaturedWork.astro / Philosophy.astro
// and the last commit's src/pages/index.astro for the removed markup.
---

<BaseLayout>
  <main class="flex h-screen flex-col">
    <section class="relative px-[10px] pb-[80px]">
      <div class="relative z-10 ml-auto w-full pt-[clamp(5.5rem,7vh,6.5rem)] lg:w-[540px] lg:pt-[10px]">
        <h1
          data-hero
          data-split-heading
          class="font-medium leading-[30px] tracking-[-0.5px] text-[24px] text-black"
        >
          An experienced designer bringing creative ideas and technical expertise to digital products.
        </h1>
        <p
          data-hero
          data-split-paragraph
          class="mt-[6px] text-[14px] leading-normal tracking-[-0.1px] text-black"
        >
          For the past decade I've designed and built digital products end to end, shaping rough, early ideas into things that feel clear and considered. From early startups to established brands, the aim is always the same; designs built to last.
        </p>
      </div>
    </section>
    <ProjectGallery />
  </main>
</BaseLayout>
